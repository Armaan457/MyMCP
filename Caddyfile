{$DOMAIN_NAME} {
    # CORS headers for web-based clients (ChatGPT, Claude web, MCP Inspector)
    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "*"
        respond 204
    }

    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "*"

    # Serve the landing page when visiting root /
    handle / {
        root * /var/www/html
        file_server
    }

    # Serve static assets if requested
    @static {
        file {
            root /var/www/html
            try_files {path}
        }
    }
    handle @static {
        root * /var/www/html
        file_server
    }

    # Reverse proxy MCP endpoints (/sse, /messages, etc.) to FastMCP container
    handle {
        reverse_proxy mcp-server:7860 {
            flush_interval -1
        }
    }
}
